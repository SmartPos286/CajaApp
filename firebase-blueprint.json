        "totalCommissionUsd": { "type": "number" },
        "retencionIvaUsd": { "type": "number" },
        "retencionIvaPercentage": { "type": "number" },
        "retencionIslrUsd": { "type": "number" },
        "retencionIslrPercentage": { "type": "number" },
        "withholdingVoucherNumber": { "type": "string" },
        "withholdingStatus": { "type": "string" },
        "deviceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "customerName", "customerDocument", "timestampMs", "rateBcv", "totalUsd", "totalBs",
        "paymentCashUsd", "paymentMobileBs", "paymentCardBs", "paymentCreditUsd", "paymentCasheaUsd",
        "creditPaid", "creditPaidAmountUsd", "creditDueDate", "creditNotes", "igtfUsd", "igtfBs",
        "baseTaxableUsd", "baseExemptUsd", "ivaUsd", "discountUsd", "cashierName", "cashRegisterNumber",
        "totalCommissionUsd", "retencionIvaUsd", "retencionIvaPercentage", "retencionIslrUsd",
        "retencionIslrPercentage", "withholdingVoucherNumber", "withholdingStatus", "deviceId",
        "createdAt", "updatedAt"
