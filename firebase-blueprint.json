      "required": [
        "userId", "quoteNumber", "customerName", "customerDocument", "customerPhone",
        "timestampMs", "validityDays", "validUntil", "rateBcv", "baseTaxableUsd", "baseExemptUsd",
        "ivaUsd", "discountUsd", "totalUsd", "totalBs", "notesOrConditions", "status",
        "cashierName", "cashRegisterNumber", "createdAt", "updatedAt"
      ]
    },
    "FsQuoteItem": {
      "title": "FsQuoteItem",
