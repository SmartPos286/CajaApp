      "required": [
        "userId", "googleEmail", "storeName", "storeRif", "deviceId", "deviceModel",
        "formatVersion", "productsCount", "salesCount", "customersCount",
        "exportedAtMs", "encryptedPayload", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Root account document for the Google-authenticated business."
    },
    "/users/{userId}/company_profile/{profileId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Company profile and POS settings synchronized across connected devices."
    },
    "/users/{userId}/products/{productId}": {
      "schema": { "$ref": "#/entities/FsProduct" },
      "description": "Shared real-time product catalog and stock levels."
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/FsSale" },
      "description": "Completed POS sales synchronized in real time."
    },
    "/users/{userId}/sale_items/{itemId}": {
      "schema": { "$ref": "#/entities/FsSaleItem" },
      "description": "Individual sale line items."
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/FsCustomer" },
      "description": "Customer directory."
    },
    "/users/{userId}/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/FsQuote" },
      "description": "Customer quotes and estimates."
    },
    "/users/{userId}/quote_items/{itemId}": {
      "schema": { "$ref": "#/entities/FsQuoteItem" },
      "description": "Individual quote line items."
    },
    "/users/{userId}/delivery_notes/{noteId}": {
      "schema": { "$ref": "#/entities/FsDeliveryNote" },
      "description": "Delivery dispatch notes."
    },
    "/users/{userId}/delivery_note_items/{itemId}": {
      "schema": { "$ref": "#/entities/FsDeliveryNoteItem" },
      "description": "Individual delivery note line items."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/FsExpense" },
      "description": "Business operating expenses."
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/FsSupplier" },
      "description": "Suppliers directory."
    },
    "/users/{userId}/purchase_invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/FsPurchaseInvoice" },
      "description": "Supplier purchase invoices."
    },
    "/users/{userId}/pos_users/{posUserId}": {
      "schema": { "$ref": "#/entities/FsPosUser" },
      "description": "POS operator profiles for cashiers and supervisors."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/FsDevice" },
      "description": "Connected devices actively sharing the account database."
    },
    "/users/{userId}/encrypted_backups/{backupId}": {
      "schema": { "$ref": "#/entities/FsEncryptedBackup" },
      "description": "Latest AES-256-GCM encrypted JSON backup updated in-place every 20 minutes."
    }
  }
}
