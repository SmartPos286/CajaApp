      "properties": {
        "userId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "priceUsd": { "type": "number" },
        "stock": { "type": "number" },
        "costPriceUsd": { "type": "number" },
        "invoiceNumber": { "type": "string" },
        "taxExempt": { "type": "boolean" },
        "hasCommission": { "type": "boolean" },
        "commissionPercentage": { "type": "number" },
        "commissionAmountUsd": { "type": "number" },
        "recipe": { "type": "boolean" },
        "combo": { "type": "boolean" },
        "comboItemsJson": { "type": "string" },
        "allowDecimalQuantity": { "type": "boolean" },
        "priceModifiable": { "type": "boolean" },
        "wholesalePriceUsd": { "type": "number" },
        "aisleNumber": { "type": "string" },
        "aisleQuantity": { "type": "number" },
        "depotQuantity": { "type": "number" },
        "counterQuantity": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "code", "name", "category", "priceUsd", "stock", "costPriceUsd", "invoiceNumber",
        "taxExempt", "hasCommission", "commissionPercentage", "commissionAmountUsd", "recipe",
        "combo", "comboItemsJson", "allowDecimalQuantity", "priceModifiable", "wholesalePriceUsd",
        "aisleNumber", "aisleQuantity", "depotQuantity", "counterQuantity", "createdAt", "updatedAt"
      ]
    },
