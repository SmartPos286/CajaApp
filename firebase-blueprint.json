{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated Google account root record for multi-device POS synchronization.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the signed-in Google account." },
        "email": { "type": "string", "description": "Google email address." },
        "displayName": { "type": "string", "description": "Google account display name." },
        "lastActiveAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last activity." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp." }
      },
      "required": ["userId", "email", "displayName", "lastActiveAt", "createdAt", "updatedAt"]
    },
    "CompanyProfile": {
      "title": "CompanyProfile",
      "description": "Store profile, tax ID, BCV exchange rate, and POS settings synchronized across devices.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "googleEmail": { "type": "string" },
        "storeName": { "type": "string" },
        "storeRif": { "type": "string" },
        "storePhone": { "type": "string" },
        "storeAddress": { "type": "string" },
        "bcvRate": { "type": "number" },
        "minProfitMarginEnabled": { "type": "boolean" },
        "minProfitMarginPercent": { "type": "number" },
        "cashRegisterCommissionEnabled": { "type": "boolean" },
        "commissionEnabledRegisters": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "googleEmail", "storeName", "storeRif", "storePhone", "storeAddress",
        "bcvRate", "minProfitMarginEnabled", "minProfitMarginPercent",
        "cashRegisterCommissionEnabled", "commissionEnabledRegisters", "createdAt", "updatedAt"
      ]
    },
    "FsProduct": {
      "title": "FsProduct",
