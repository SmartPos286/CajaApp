    "FsEncryptedBackup": {
      "title": "FsEncryptedBackup",
      "description": "AES-256-GCM encrypted JSON backup snapshot updated every 20 minutes per Google account.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "googleEmail": { "type": "string" },
        "storeName": { "type": "string" },
        "storeRif": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceModel": { "type": "string" },
        "formatVersion": { "type": "integer" },
        "productsCount": { "type": "integer" },
        "salesCount": { "type": "integer" },
        "customersCount": { "type": "integer" },
        "exportedAtMs": { "type": "integer" },
        "encryptedPayload": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
